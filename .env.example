# Copy to .env and adjust. Every value shown is the default unless noted.

# --- Dashboard (for you, not attackers). Keep it private. -------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_USERNAME=admin
# Required whenever DASHBOARD_HOST is not loopback (always the case in Docker).
DASHBOARD_PASSWORD=change-me-to-a-long-random-string

# --- Decoy services ---------------------------------------------------------
# Use 0.0.0.0 to accept connections from other machines.
FAKE_HTTP_HOST=127.0.0.1
FAKE_HTTP_PORT=8080
FAKE_SHELL_HOST=127.0.0.1
FAKE_SHELL_PORT=2222
FAKE_MQTT_HOST=127.0.0.1
FAKE_MQTT_PORT=1883
FAKE_TELNET_HOST=127.0.0.1
# Port 23 needs root. Keep 2323 and map 23 -> 2323 (Docker does this for you).
FAKE_TELNET_PORT=2323

ENABLE_HTTP=true
ENABLE_SHELL=true
ENABLE_MQTT=true
ENABLE_TELNET=true

# --- Limits -----------------------------------------------------------------
HONEYPOT_MAX_CONNECTIONS=200
HONEYPOT_MAX_CONNECTIONS_PER_IP=10
HONEYPOT_SESSION_TIMEOUT=300
HONEYPOT_IDLE_TIMEOUT=60
HONEYPOT_MAX_LINE_BYTES=4096
HONEYPOT_MAX_COMMANDS=500
HONEYPOT_MAX_RAW_INPUT=2000
HONEYPOT_MAX_HTTP_BODY=65536
# Oldest events are deleted beyond this many rows (0 = keep everything).
HONEYPOT_MAX_EVENTS=500000

# --- Classifier -------------------------------------------------------------
HONEYPOT_USE_ML=true
HONEYPOT_ML_MIN_CONFIDENCE=0.45

# --- Storage / logging ------------------------------------------------------
# HONEYPOT_DATA_DIR=./data
# HONEYPOT_LOG_DIR=./logs
HONEYPOT_LOG_LEVEL=INFO
